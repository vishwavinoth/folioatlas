# ─────────────────────────────────────────────────────────────────────────────
# FolioAtlas — environment configuration
#
# REQUIRED for the core app:  DATABASE_URL (local SQLite works out of the box)
# Everything else is optional; features degrade gracefully when unset.
# NEVER commit real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (required) ─────────────────────────────────────────────────────
# Local SQLite (default; file is created by `bun run db:push`).
# NOTE: Prisma resolves relative SQLite paths against prisma/schema.prisma,
# so "../db/custom.db" means "<project>/db/custom.db".
DATABASE_URL="file:../db/custom.db"

# ── Canonical origin (recommended in production) ────────────────────────────
# Used for metadata, canonical URLs, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=

# ── Upstream source configuration (defaults shown) ──────────────────────────
# Optional read-only GitHub token (least privilege, no scopes needed).
GITHUB_TOKEN=
GITHUB_OWNER=emmabostian
GITHUB_REPO=developer-portfolios
GITHUB_REF=
GITHUB_README_PATH=README.md

# ── AI features (optional; server-side only) ────────────────────────────────
# When GROQ_API_KEY is set, Groq is used for AI search intent parsing and
# portfolio summaries (JSON mode). Without it, the app falls back to its
# built-in provider and — if that is also absent — to plain keyword search.
GROQ_API_KEY=
# Any Groq chat model that supports JSON mode. Default: llama-3.3-70b-versatile
GROQ_MODEL=

# ── Website previews (optional; server-side only) ───────────────────────────
# Default provider requires no credentials (WordPress mShots, public endpoint).
# Set PREVIEW_PROVIDER=none to disable previews entirely, or configure a key
# for the trusted ScreenshotOne provider (its key never reaches the browser).
PREVIEW_PROVIDER=
SCREENSHOT_ONE_ACCESS_KEY=

# ── Supabase (optional; production deployment only) ─────────────────────────
# See supabase/README.md for setup + RLS verification steps. The app runs on
# the local Prisma/SQLite layer until these are configured and verified.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER-ONLY. Bypasses Row Level Security — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Embeddings (optional; only if semantic vector search is enabled) ────────
# Groq does not currently provide a general-purpose embedding endpoint; if
# pgvector search is wired up, configure a compatible provider here.
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
