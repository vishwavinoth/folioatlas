# ─────────────────────────────────────────────────────────────────────────────
# FolioAtlas — environment configuration
#
# REQUIRED: the three Supabase values below (see supabase/README.md).
# Everything else is optional; features degrade gracefully when unset.
# NEVER commit real credentials. Copy to .env.local for local development.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (required) ─────────────────────────────────────────────────────
# Project Settings → API. The publishable (anon) key is read-only under RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER-ONLY. Bypasses Row Level Security — never expose to the browser.
# Used for AI summary writes and by scripts/seed-db.ts. Without it, AI
# summaries are disabled; the directory still works.
SUPABASE_SECRET_KEY=

# ── Canonical origin (recommended in production) ────────────────────────────
# Used for metadata, canonical URLs, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=

# ── AI features (optional; server-side only) ────────────────────────────────
# Enables AI search intent parsing and portfolio summaries (Groq, JSON mode).
# Without it, AI endpoints return 503 and the UI falls back to keyword search.
GROQ_API_KEY=
# Any Groq chat model that supports JSON mode. Default: llama-3.3-70b-versatile
GROQ_MODEL=

# ── Data pipeline (scripts only; defaults shown) ────────────────────────────
# Optional read-only GitHub token (least privilege, no scopes needed).
GITHUB_TOKEN=
GITHUB_OWNER=emmabostian
GITHUB_REPO=developer-portfolios
GITHUB_REF=
GITHUB_README_PATH=README.md
